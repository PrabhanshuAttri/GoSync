# Copy this file to .env and adjust as needed.
# `docker-compose.yml` reads this file automatically; a plain `docker run` or a
# local `python -m gosync` process reads these as regular environment
# variables instead.
# See docs/usage.md#environment-configuration for full details.

# --- docker-compose only (host machine, not read by the app itself) ---

# Host path bind-mounted to the container's /data.
GOSYNC_VOLUME_PATH=./data

# Host port mapped to the container's web UI (container always listens on
# WEB_PORT internally).
GOSYNC_WEB_PORT=49152

# Image tag to pull, e.g. latest, main, or a released version like 1.3.0.
GOSYNC_IMAGE_TAG=latest

# --- Runtime environment ---

# production (default) or dev/development to enable Flask debug mode.
ENV=production

# --- Data directory and files ---
# DATA_DIR is fixed to /data inside the published container image; only
# change it for a local (non-Docker) run.
# DATA_DIR=/data

# HAR filename inside DATA_DIR. Must be a bare *.har filename (no paths).
# Defaults to gopro.com.har, then any single *.har file found in DATA_DIR.
HAR_FILE=gopro.com.har

# --- Authentication ---

# How to authenticate against GoPro Cloud: "har" (default, export a browser
# HAR -- see HAR_FILE above) or "api_token" (paste a captured bearer token
# instead of a full HAR export).
AUTH_METHOD=har

# Bearer token captured from a DevTools request to api.gopro.com. Required
# only when AUTH_METHOD=api_token. Treat this like a password -- it grants
# full access to the account's GoPro Cloud media.
# AUTH_TOKEN=

# Optional GoPro account/user id, used only to scope AUTH_METHOD=api_token
# media searches. Not required for authentication itself.
# USER_ID=

# Also fetch per-item mediainfo.json and GPX/GPMF telemetry sidecars. Off by
# default -- adds two extra live API calls per item on top of the normal
# download, so it can meaningfully slow down large libraries.
DOWNLOAD_TELEMETRY=false

# Generate Immich-compatible XMP sidecar files next to each downloaded media
# file. On by default.
CREATE_XMP_SIDECARS=true

# Download output folder name or path. Relative paths resolve inside
# DATA_DIR.
DOWNLOAD_FOLDER=downloads

# Legacy alias for DOWNLOAD_FOLDER, only used if DOWNLOAD_FOLDER is unset.
# Prefer DOWNLOAD_FOLDER.
# OUTPUT_FOLDER=downloads

# JSON resume-state filename or path. Relative paths resolve inside
# DATA_DIR.
GOSYNC_STATE_FILE=gosync_state.json

# --- Download batching ---

# Maximum total source bytes per zip download batch. "auto" uses the
# largest file_size found in the HAR manifest. Accepts a byte count, e.g.
# 2147483648 for 2 GiB.
BATCH_MAX_BYTES=auto

# HTTP request timeout (seconds) for GoPro API calls.
REQUEST_TIMEOUT_SECONDS=60

# --- Chapter merging (ffmpeg) ---

# ffmpeg binary name or path used to merge GoPro chapter files into a
# single target file. Must be resolvable via PATH (or an absolute path).
FFMPEG_BINARY=ffmpeg

# Timeout (seconds) for each ffmpeg chapter-merge subprocess call.
FFMPEG_TIMEOUT_SECONDS=900

# exiftool binary name or path, used after a chapter merge to copy GoPro's
# proprietary camera/lens/firmware metadata onto the merged file (ffmpeg's
# stream copy alone doesn't preserve it). Must be resolvable via PATH (or an
# absolute path). If not found, merges still succeed, just without this
# metadata copy step.
EXIFTOOL_BINARY=exiftool

# Timeout (seconds) for each exiftool metadata-copy subprocess call.
EXIFTOOL_TIMEOUT_SECONDS=300

# ffprobe binary name or path, used to sanity-check chapter files (that each
# one is a valid, readable container) before trusting them as merge inputs.
# If not found, this check falls back to a size-only heuristic.
FFPROBE_BINARY=ffprobe

# Timeout (seconds) for each ffprobe chapter-integrity check.
FFPROBE_TIMEOUT_SECONDS=30

# --- Chapter-merge size tolerance ---
# A merged chapter file's size is compared against the sum of its raw
# chapters' sizes to detect truncation/corruption. Because container remux
# overhead is roughly constant per chapter (not proportional to file size),
# the tolerance is chapter-count-scaled bytes with a floor and ceiling,
# rather than a percentage of file size. See gosync.chapters.tolerance_bytes.

# Tolerance bytes added per chapter in the merge.
PER_CHAPTER_OVERHEAD_BYTES=10485760

# Minimum tolerance regardless of chapter count (covers small clips).
MIN_TOLERANCE_BYTES=4194304

# Maximum tolerance regardless of chapter count (caps the blind spot on
# very large, many-chapter recordings).
MAX_TOLERANCE_BYTES=209715200

# Maximum number of chaptered items the local-merge short-circuit will
# process (ffmpeg + exiftool) in a single run, so a large backlog can't hold
# the run's lock for an unbounded amount of time. The rest are picked up on
# the next run.
MAX_LOCAL_MERGES_PER_RUN=10

# --- Web server ---
# WEB_HOST/WEB_PORT are fixed inside the published container image; only
# change them for a local (non-Docker) run. Use GOSYNC_WEB_PORT above to
# change the host-side port when using docker-compose.
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# Maximum accepted HAR upload size in bytes.
MAX_HAR_UPLOAD_BYTES=104857600

# Set to false to hide Flask access logs, including /status polling.
ACCESS_LOGS=true
